# ============================================================
# .env.example — dynamic_quiz_app
#
# Copy this file to .env and fill in your real values.
# The .env file is listed in .gitignore and must NEVER be
# committed to version control.
#
# Usage:
#   cp .env.example .env
# ============================================================

# ── App Domain / SSL (Caddy) ───────────────────────────────
# For local dev, leave these empty.
# For production, set your domain to get an automatic Let's Encrypt certificate.
DOMAIN=
ACME_EMAIL=

# ── Gemini AI ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Cohere (embeddings + LLM) ─────────────────────────────
COHERE_API_KEY=your_cohere_api_key_here

# ── Other LLM providers (optional) ───────────────────────
GITHUB_TOKEN=your_github_pat_here
GROQ_API_KEY=your_groq_api_key_here

# ── Redis / Celery ─────────────────────────────────────────
# Local development: redis://localhost:6379/0
# Docker (auto-overridden by compose): redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ── Qdrant Vector DB ──────────────────────────────────────
# Local / Docker local:
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=course_chunks
# Qdrant Cloud (uncomment and fill if using managed Qdrant):
# QDRANT_URL=https://<cluster-id>.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key_here

# ── MinIO Object Storage ───────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCUMENTS=course-documents
MINIO_BUCKET_QUIZZES=generated-quizzes
MINIO_USE_SSL=false

# ── PostgreSQL ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require
SYNC_DATABASE_URL=postgresql+psycopg2://user:password@host/dbname?sslmode=require

# ── JWT Authentication ─────────────────────────────────────
JWT_SECRET_KEY=change_this_to_a_long_random_string_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── App General ────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
