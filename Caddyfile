{
    # Global options
    # This email is used by Let's Encrypt for certificate expiry warnings.
    email {$ACME_EMAIL}
}

# The domain name is injected from the .env file.
# If DOMAIN is not set, it defaults to http://localhost for local development.
# If DOMAIN is set to a real domain (e.g. quiz.example.com), Caddy will automatically
# request and renew a free Let's Encrypt SSL/TLS certificate for you.

{$DOMAIN} {
    # Route all traffic to the FastAPI app running in the 'api' container
    reverse_proxy api:8000
}
